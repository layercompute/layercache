{
  "name": "@layercache/native",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "native/dist/expo.cjs",
  "exports": {
    ".": "./native/dist/expo.cjs",
    "./client": "./native/dist/client.js",
    "./llm": {
      "types": "./native/dist/types/llm.d.ts",
      "import": "./native/dist/llm.js"
    }
  },
  "bin": {
    "layercache-native": "native/dist/cli.js"
  },
  "files": [
    "native/dist",
    "native/README.md",
    "native/LLM.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "node native/build.ts && node dashboard/build.ts && node cloud/build.ts",
    "typecheck": "tsc --noEmit && tsc -p dashboard/tsconfig.json && tsc -p qa/dashboard/tsconfig.json && tsc -p cloud/tsconfig.json && tsc -p qa/cloud/tsconfig.json",
    "test": "node --test native/*.test.ts deploy/pool/*.test.ts",
    "test:dashboard": "node qa/dashboard/run.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:cloud": "node qa/cloud/run.ts",
    "qa:nx-native": "node --test qa/nx-native/*.test.mjs && node qa/nx-native/run.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "secure-json-parse": "4.1.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.17",
    "@playwright/test": "1.63.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.13.3",
    "ai": "7.0.107",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "ai": "^7.0.107"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
