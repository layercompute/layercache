{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["dependency.json"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "env": ["TEST_PROFILE"],
      "passThroughEnv": ["EXECUTION_COUNTER"]
    },
    "test": {
      "outputs": [".test/**"],
      "env": ["TEST_PROFILE"],
      "passThroughEnv": ["EXECUTION_COUNTER"]
    }
  }
}
